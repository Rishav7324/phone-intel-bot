# =====================================================================
# Telegram Phone Number Intelligence Bot - Environment Configuration
# =====================================================================

# Telegram Bot Token obtained from @BotFather (Required)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram User ID(s) of the bot administrators for /stats command (Optional)
ADMIN_ID=

# Path to the SQLite database file for anonymous usage statistics
DATABASE_PATH=bot.db

# Optional default ISO-3166-1 2-letter country code fallback (e.g. IN, US, GB)
DEFAULT_REGION=

# Rate limiting settings (lookups allowed per user per minute)
RATE_LIMIT_PER_MINUTE=10

# In-memory cache TTL for identical number lookups in seconds (default: 600 = 10 mins)
CACHE_TTL_SECONDS=600

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application environment: production or development
ENVIRONMENT=production
